# Public Supabase project URL and anon key. Safe for the browser; never use a service role here.
# Setting both switches sign-in from mock mode to real Google OAuth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for cross-user vector matching; never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth, read by the Supabase CLI for local sign-in (see supabase/config.toml).
# Hosted projects set these in the dashboard instead. Authorised redirect URI for the
# Google credential is <supabase-url>/auth/v1/callback.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Databricks Model Serving (server-only). Production requires all four values.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_EMBEDDING_ENDPOINT=
EMBEDDING_MODEL=

# Optional. Chat endpoint that maps résumé phrasings onto existing catalogue
# skills during onboarding ("retrieval augmented generation" -> rag). Needs a
# reasoning model: instruct models echo the catalogue back instead of reading
# the document. Defaults to databricks-gpt-oss-120b; unset simply skips the
# step, leaving the deterministic matcher's results.
DATABRICKS_SKILL_ENDPOINT=

# Optional. Chat endpoint that writes the ten-question assessment offered once
# a roadmap is fully ticked. A general instruct model, not the reasoning model
# above: this is generation, not judgement. Defaults to
# databricks-meta-llama-3-3-70b-instruct. Genie cannot do this job — it is
# scoped to the campus data room and declines questions about Docker.
DATABRICKS_ASSESSMENT_ENDPOINT=

# Optional. Signs the answer key that travels with an assessment so it can be
# marked on the server without storing the attempt. Any long random string.
# Falls back to SUPABASE_SERVICE_ROLE_KEY, and then to a per-process random
# value — fine for one dev server, but on more than one instance a student
# would be marked by a process that cannot verify their token. Set it in
# production.
ASSESSMENT_SIGNING_SECRET=

# Databricks Genie Agent (formerly Genie Space), SQL Warehouse, and Delta namespace.
# Find the space id in the Agent URL (/genie/rooms/<id>), or list them with
#   GET {DATABRICKS_HOST}/api/2.0/genie/spaces
# `scripts/databricks-deploy.mjs --genie` creates the Agent and prints the id.
DATABRICKS_GENIE_SPACE_ID=
DATABRICKS_SQL_WAREHOUSE_ID=
# The default Unity Catalog is `workspace` on newer accounts and `main` on
# older ones. List yours: GET /api/2.1/unity-catalog/catalogs
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=campusquest
# Optional Databricks AI Search research-candidate retrieval (server-only).
# Provision with: node scripts/setup-research-ai-search.mjs
DATABRICKS_AI_SEARCH_ENDPOINT=campusquest-research-search
DATABRICKS_RESEARCH_SEARCH_INDEX=
# Databricks Job ID for databricks/etl/sync_profiles/sync_profiles.py.
DATABRICKS_PROFILE_SYNC_JOB_ID=

# Databricks SQL Statement Execution for the P4 research view (server-only).
P4_RESEARCH_PROJECTS_TABLE=

# Optional P2 adapters. Use an absolute, authenticated URL for the rationale route;
# their failures leave deterministic SQL/application scores intact.
P2_SKILL_GAP_URL=
P2_GENIE_RATIONALE_URL=
PROFILE_SYNC_WEBHOOK_URL=
# Used by P3's quest completion webhook and /api/internal/profile-sync.
PROFILE_SYNC_WEBHOOK_SECRET=

# Development only. Allows mock Supabase-independent API behavior. Do not set in production.
CAMPUSQUEST_LOCAL_FALLBACK=true
# Internal absolute origin used by server components while calling route handlers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
