{
  "datasets": [
    {
      "name": "ds_year_summary",
      "displayName": "Placements by year",
      "queryLines": [
        "SELECT year, students_in_drive, students_placed, placement_rate_pct,\n",
        "       offers, offer_conversion_pct, companies_recruiting,\n",
        "       highest_package_lpa, median_package_lpa, average_package_lpa\n",
        "FROM {{catalog}}.{{schema}}.placement_year_summary\n",
        "ORDER BY year"
      ]
    },
    {
      "name": "ds_latest_year",
      "displayName": "Most recent placement year",
      "queryLines": [
        "SELECT year, students_in_drive, students_placed, placement_rate_pct,\n",
        "       offers, offer_conversion_pct, companies_recruiting,\n",
        "       highest_package_lpa, median_package_lpa\n",
        "FROM {{catalog}}.{{schema}}.placement_year_summary\n",
        "WHERE year = (SELECT MAX(year) FROM {{catalog}}.{{schema}}.placement_year_summary)"
      ]
    },
    {
      "name": "ds_top_offers",
      "displayName": "Highest packages by company",
      "queryLines": [
        "SELECT year, company_name, sector, tier, offers,\n",
        "       highest_package_lpa, median_package_lpa, package_rank_in_year\n",
        "FROM {{catalog}}.{{schema}}.placement_top_offers\n",
        "WHERE package_rank_in_year <= 10\n",
        "ORDER BY year DESC, package_rank_in_year"
      ]
    },
    {
      "name": "ds_recurrence",
      "displayName": "Which companies keep coming back",
      "queryLines": [
        "SELECT company_name, sector, tier, return_outlook, years_recruited,\n",
        "       years_in_window, presence_pct, last_seen_year, processes_run,\n",
        "       total_offers, best_package_lpa\n",
        "FROM {{catalog}}.{{schema}}.placement_company_recurrence\n",
        "ORDER BY presence_pct DESC, best_package_lpa DESC"
      ]
    },
    {
      "name": "ds_role_family",
      "displayName": "Role families hired for",
      "queryLines": [
        "SELECT year, role_family, companies_hiring, students_interviewed, offers,\n",
        "       offer_conversion_pct, highest_package_lpa, median_package_lpa\n",
        "FROM {{catalog}}.{{schema}}.placement_role_family_year\n",
        "ORDER BY year DESC, offers DESC"
      ]
    },
    {
      "name": "ds_branch",
      "displayName": "Outcomes by branch",
      "queryLines": [
        "SELECT branch, students_in_drive, students_placed, placement_rate_pct,\n",
        "       offers, median_package_lpa, highest_package_lpa\n",
        "FROM {{catalog}}.{{schema}}.placement_branch_summary\n",
        "ORDER BY median_package_lpa DESC"
      ]
    },
    {
      "name": "ds_skill_edge",
      "displayName": "Skills the placed students held",
      "queryLines": [
        "SELECT skill_name, category, placed_holders, campus_holders,\n",
        "       placed_holding_pct, campus_holding_pct, lift_pct_points\n",
        "FROM {{catalog}}.{{schema}}.placement_skill_edge\n",
        "ORDER BY lift_pct_points DESC\n",
        "LIMIT 15"
      ]
    }
  ],
